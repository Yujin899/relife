rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isOwner() {
      return hasRole('owner');
    }
    
    function isAdmin() {
      return hasRole('admin') || isOwner();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isOwner();
    }
    
    // Subjects & Quizzes & Questions
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }
    
    // Mistakes
    match /mistakes/{mistakeId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }
    
    // Badges
    match /user_badges/{badgeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Quests (Private progress tracking)
    match /quests/{questId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == resource.data.userId || isOwner());
    }

    // Admins helper collection (legacy or backup)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
