      "description": "Area, perimeter, and shapes",
      "questions": [
        {
          "text": "What is the area of a triangle with base 10 and height 6?",
          "options": [
            { "id": "a", "text": "60" },
            { "id": "b", "text": "16" },
            { "id": "c", "text": "30" },
            { "id": "d", "text": "36" }
          ],
          "correctOptionId": "c",
          "explanation": "The area of a triangle is (base * height) / 2. So, (10 * 6) / 2 = 30."
        },
        {
          "text": "What is the perimeter of a rectangle with length 8 and width 5?",
          "options": [
            { "id": "a", "text": "13" },
            { "id": "b", "text": "26" },
            { "id": "c", "text": "40" },
            { "id": "d", "text": "20" }
          ],
          "correctOptionId": "b",
          "explanation": "The perimeter of a rectangle is 2 * (length + width). So, 2 * (8 + 5) = 26."
        },
        {
          "text": "What is the square root of 144?",
          "options": [
            { "id": "a", "text": "11" },
            { "id": "b", "text": "12" },
            { "id": "c", "text": "13" },
            { "id": "d", "text": "14" }
          ],
          "correctOptionId": "b",
          "explanation": "12 squared is 144, so the square root of 144 is 12."
        },
        {
          "text": "What is 15% of 200?",
          "options": [
            { "id": "a", "text": "15" },
            { "id": "b", "text": "20" },
            { "id": "c", "text": "25" },
            { "id": "d", "text": "30" }
          ],
          "correctOptionId": "d",
          "explanation": "15% of 200 is calculated as (15/100) * 200, which equals 30."
        }
      ]
    },
    {
