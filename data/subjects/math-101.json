      "description": "Derivatives, functions, and slopes",
      "questions": [
        {
          "text": "What is the derivative of x³?",
          "options": [
            { "id": "a", "text": "x²" },
            { "id": "b", "text": "3x" },
            { "id": "c", "text": "3x²" },
            { "id": "d", "text": "2x³" }
          ],
          "correctOptionId": "c",
          "explanation": "Using the power rule, the derivative of x^n is nx^(n-1). For x³, it's 3x²."
        },
        {
          "text": "If f(x) = 2x² + 3, what is f(2)?",
          "options": [
            { "id": "a", "text": "7" },
            { "id": "b", "text": "11" },
            { "id": "c", "text": "9" },
            { "id": "d", "text": "13" }
          ],
          "correctOptionId": "b",
          "explanation": "Substitute x = 2 into the function: 2(2)² + 3 = 2(4) + 3 = 11."
        },
        {
          "text": "What is the slope of the line y = 3x - 7?",
          "options": [
            { "id": "a", "text": "-7" },
            { "id": "b", "text": "7" },
            { "id": "c", "text": "3" },
            { "id": "d", "text": "-3" }
          ],
          "correctOptionId": "c",
          "explanation": "In the equation y = mx + b, 'm' is the slope. Here, m = 3."
        }
      ]
