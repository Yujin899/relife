      "quizId": "math-algebra-basics",
      "title": "Algebra Basics",
      "description": "Equations, simplification, and variables",
      "questions": [
        {
          "text": "What is the value of x in the equation 2x + 6 = 14?",
          "options": [
            { "id": "a", "text": "2" },
            { "id": "b", "text": "4" },
            { "id": "c", "text": "6" },
            { "id": "d", "text": "8" }
          ],
          "correctOptionId": "b",
          "explanation": "Subtract 6 from both sides to get 2x = 8, then divide by 2 to find x = 4."
        },
        {
          "text": "Simplify: 3(x + 4) - 2x",
          "options": [
            { "id": "a", "text": "x + 12" },
            { "id": "b", "text": "x + 4" },
            { "id": "c", "text": "5x + 4" },
            { "id": "d", "text": "5x + 12" }
          ],
          "correctOptionId": "a",
          "explanation": "Distribute 3 across (x + 4) to get 3x + 12 - 2x, which simplifies to x + 12."
        },
        {
          "text": "Solve for x: x/3 = 9",
          "options": [
            { "id": "a", "text": "3" },
            { "id": "b", "text": "6" },
            { "id": "c", "text": "27" },
            { "id": "d", "text": "12" }
          ],
          "correctOptionId": "c",
          "explanation": "Multiply both sides by 3 to isolate x: x = 9 * 3 = 27."
        },
        {
          "text": "If a = 5 and b = 3, what is a² - b²?",
          "options": [
            { "id": "a", "text": "8" },
            { "id": "b", "text": "16" },
            { "id": "c", "text": "34" },
            { "id": "d", "text": "2" }
          ],
          "correctOptionId": "b",
          "explanation": "Substitute the values: 5² - 3² = 25 - 9 = 16."
        },
        {
          "text": "What is 2³ × 2²?",
          "options": [
            { "id": "a", "text": "16" },
            { "id": "b", "text": "32" },
            { "id": "c", "text": "64" },
            { "id": "d", "text": "10" }
          ],
          "correctOptionId": "b",
          "explanation": "When multiplying like bases, add the exponents: 2^(3+2) = 2^5 = 32."
        }
      ]
    },
    {
      "quizId": "math-geometry",
